# Copy to .env and fill in. `scripts/local-env.sh` writes .env.local (overrides
# the Supabase settings below with the local stack) and web/.env.local.

# --- Third-party APIs (server only) ---
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Resend has no verified domain: every customer email is delivered here instead.
DEMO_CUSTOMER_EMAIL=you@example.com
# resend | log  (log = print emails instead of sending; tests use log)
EMAIL_MODE=resend

# --- Reminder calls (Sarvam voice agent over your Twilio connection) ---
# sarvam = real calls | mock = fake "picked up, promised to pay" outcome | log = record only (tests)
CALL_MODE=mock
# Voice Agents API key (Settings -> API Key in the agents dashboard); not the STT/TTS key above.
SARVAM_AGENTS_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
# The Twilio number the agent calls from, E.164 (e.g. +14155550123).
SARVAM_AGENT_PHONE=
# Optional: force the agent's opening language (Hindi, English, ...).
SARVAM_CALL_LANGUAGE=
# Token on the webhook URL Sarvam calls back (defaults to CRON_SECRET). Sarvam must reach
# PUBLIC_API_BASE, so use the deployed API or a tunnel when testing calls locally.
SARVAM_WEBHOOK_SECRET=
# Twilio trial accounts only call verified numbers: every customer call goes here instead.
DEMO_CUSTOMER_PHONE=
# Give seeded customers real phones for the call demo (applied by `make seed`):
# DEMO_CALL_PHONES=Sharma Traders=+91 98xxxxxxxx, Priya Caterers=+91 97xxxxxxxx
DEMO_CALL_PHONES=

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Direct Postgres connection used by the API (pooler URL on hosted Supabase).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres

# --- Paytm (see docs/paytm/PAYTM_INTEGRATION.md) ---
PAYTM_MODE=mock
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
# 16-character key the mock gateway signs its fake webhooks with.
PAYTM_MOCK_KEY=HisaabMockKey#01

# --- Service URLs ---
PUBLIC_API_BASE=http://localhost:8000
PUBLIC_WEB_BASE=http://localhost:3000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared secret for POST /jobs/tick (the cron service sends it as X-Cron-Secret).
CRON_SECRET=change-me
# Run /jobs/tick every 5 minutes inside the API process (local dev convenience).
RUN_SCHEDULER=false

# --- Demo merchant (local test account created by the seed) ---
DEMO_MERCHANT_EMAIL=demo@hisaabbolo.test
DEMO_MERCHANT_PASSWORD=hisaab-demo-2026

# --- Web (Next.js reads these from web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE=http://localhost:8000
